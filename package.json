{
  "name": "hivecore-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"wrangler dev --local --ip 127.0.0.1 --port 8787\"",
    "build": "tsc --noEmit && vite build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write src worker shared tests *.json *.jsonc *.ts *.html *.md",
    "test:live": "node scripts/live-test.mjs",
    "dev:live": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"wrangler dev --config wrangler.live.jsonc --ip 127.0.0.1 --port 8787\""
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.40.0"
  }
}
